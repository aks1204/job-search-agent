# Copy to .env and fill in. Never commit .env.

# --- Required ---
POSTGRES_PASSWORD=change-me-to-something-long
ANTHROPIC_API_KEY=

# --- Optional: LLM model overrides ---
# LLM_FAST_MODEL=claude-haiku-5-5
# LLM_JUDGE_MODEL=claude-sonnet-5-5

# --- Optional free tiers (features degrade gracefully when blank) ---
BRAVE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# --- Optional: Module 3 contact discovery (each one is optional; more = better hit rate) ---
# Hunter: email lookup + verification (free plan). https://hunter.io/api-keys
HUNTER_API_KEY=
# Apollo: person email lookup. Its free API needs an account registered with a work email.
APOLLO_API_KEY=
# MyEmailVerifier: mailbox verification (free daily credits). Client area -> API settings.
MYEMAILVERIFIER_API_KEY=
# Hostname used to introduce ourselves in the local mailbox check (e.g. a domain you own). Blank = this machine's name.
SMTP_HELO_HOST=

# --- Module 3 Part 3c: sending from your Gmail (Google sign-in). Setup steps: README "Connect Gmail". ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Gmail sign-in. Generate once:
#   docker compose run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
